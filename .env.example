# arm-free-catcher.sh v4.0.0 配置模板
# 用法: cp .env.example .env && 编辑必填项

# ── 必填 ──────────────────────────────────────────────────────────────
COMPARTMENT_ID=ocid1.tenancy.oc1..aaaa                    # 租户 OCID（控制台→头像→租户详细信息）
SUBNET_ID=ocid1.subnet.oc1.phx.aaaa                       # 允许公网 IP 的子网 OCID
IMAGE_ID=ocid1.image.oc1.phx.aaaa                         # 镜像 OCID（见 README 查询命令）
SSH_KEY_FILE=/home/ubuntu/.ssh/id_ed25519.pub             # 实例登录公钥（.pub）
AVAILABILITY_DOMAINS=XXXX:PHX-AD-1,XXXX:PHX-AD-2          # 轮换 AD；注意 E2.1.Micro 只有一个 AD 有效

# ── 规格 ──────────────────────────────────────────────────────────────
SHAPE=VM.Standard.A1.Flex          # 或 VM.Standard.E2.1.Micro（固定规格，自动跳过 shape-config）
OCPUS=2                            # 仅 Flex 生效（A1 Always Free 上限 2）
MEMORY_GB=12                       # 仅 Flex 生效
BOOT_VOLUME_SIZE=                  # 可选；留空用镜像默认。显式设置可利用满 200GB 免费存储额度

# ── 策略 ──────────────────────────────────────────────────────────────
DISPLAY_NAME=arm-free-1
AD_GAP=10                          # 内层 AD 间间隔秒数（>=5，过低易触发 429）
RETRY_INTERVAL=300                 # 外层退避基数秒（实际加 ±10% 随机抖动）
POLL_TIMEOUT=300                   # 单实例异步轮询超时秒
MAX_ATTEMPTS=0                     # 最大 sweep 轮数（0=无限；cron 模式忽略）

# ── 通知（可选）───────────────────────────────────────────────────────
NOTIFY_WEBHOOK=                    # 飞书机器人 webhook / telegram bot / Server酱 sendkey
NOTIFY_TYPE=feishu                 # feishu | telegram | serverchan | generic（generic 原样 POST 文本）
NOTIFY_CHAT_ID=                    # 仅 telegram 用

# ── 其他 ──────────────────────────────────────────────────────────────
USER_DATA_FILE=                    # cloud-init user-data 文件路径（可选，抢到即初始化）
LOG_FILE=./catcher.log             # 日志路径（>10MB 自动转 .1）
